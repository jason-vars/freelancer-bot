/.venv
/bot/__pycache__
.env

# Local SQLite DB (per-machine, not for version control)
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Atomic-write / editor temp files (e.g. config.py.tmp.15820.<hash>, .env.tmp)
*.tmp
*.tmp.*

# Runtime files from the background launcher (start-bot.vbs / serve)
bot.pid
bot.log
