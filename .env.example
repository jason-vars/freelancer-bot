# Freelancer API
FLN_OAUTH_TOKEN=YOUR_FREELANCER_OAUTH_TOKEN
# Optional: override base URL (e.g. sandbox) if Freelancer provides one
# FLN_URL=https://www.freelancer-sandbox.com

# Bot behavior
BOT_DRY_RUN=1
BOT_MAX_BIDS_PER_DAY=20

# ── Job-alert filters — every one is optional; the value in () disables it ──
# A project is alerted only if it passes ALL enabled filters.
BOT_MIN_SCORE=0                  # alert only if score >= this (0 = alert on all)
BOT_MIN_BUDGET_USD=0             # min budget (0 = any budget)
BOT_SKIP_CURRENCIES=             # comma-separated codes to skip (empty = none; e.g. INR)
BOT_MAX_PROJECT_AGE_SECONDS=0    # only keep projects newer than N seconds (0 = any age)
BOT_MIN_BID_REMAINING_SECONDS=0  # skip if bidding closes in < N sec (0 = off; 6d22h = 597600)
BOT_MIN_CLIENT_COMPLETED_JOBS=0  # min client completed jobs (0 = disabled; needs owner_id)
BOT_REQUIRE_PAYMENT_VERIFIED=0   # 1 = only payment-verified clients (needs owner_id)
BOT_ALLOW_COUNTRIES=             # only these client countries (empty = any)
BOT_SKIP_COUNTRIES=              # block these client countries (empty = none)
#
# NOTE: client filters (completed-jobs / payment / country) only work in the
# WEBHOOK path, which has the client owner_id. The POLLING search has no
# owner_id, so keep those disabled (0/empty) for run-loop or nothing matches.
#
# To make it stricter later, e.g.: BOT_MIN_SCORE=70, BOT_MIN_BUDGET_USD=200,
# BOT_SKIP_CURRENCIES=INR, BOT_MAX_PROJECT_AGE_SECONDS=3600.

# Search criteria (comma-separated). These decide WHICH jobs are fetched.
BOT_KEYWORDS=react,nextjs,flutter,fastapi,api,bugfix
BOT_SKILLS=javascript,react.js,next.js,python,fastapi,flutter,node.js

BOT_WEBHOOK_SAVE_ONLY=1

# Bid defaults
BOT_DEFAULT_PERIOD_DAYS=7
BOT_DEFAULT_MILESTONE_PERCENT=50

# OpenAI (for AI proposals)
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-5.2-mini

# Telegram notifications (leave blank to disable).
# 1) Create a bot via @BotFather -> get the token.
# 2) Message your bot, then get your chat id from @userinfobot
#    or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
