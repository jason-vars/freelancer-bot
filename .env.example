# Freelancer API
FLN_OAUTH_TOKEN=YOUR_FREELANCER_OAUTH_TOKEN
# Optional: override base URL (e.g. sandbox) if Freelancer provides one
# FLN_URL=https://www.freelancer-sandbox.com

# Bot behavior
BOT_DRY_RUN=1
BOT_AUTO_APPLY=0                 # master switch for AUTOMATIC bidding (0 = bot only notifies; you apply manually)
BOT_MAX_BIDS_PER_DAY=20
BOT_ACTIVE_START=                # only run between these local times, HH:MM (blank = 24/7)
BOT_ACTIVE_END=                  # e.g. START=09:00 END=18:00, or overnight 22:00 -> 06:00
BOT_PROPOSAL_INSTRUCTIONS=       # extra steering for the AI proposal (quote if multi-line)
# Per-currency/budget bid amounts as a JSON array (managed via the settings web UI).
# First matching rule wins; otherwise the budget-based default is used.
# Example: [{"currencies":["USD","AUD"],"min":30,"max":250,"bid":150,"delivery":5}]
BOT_BID_RULES=

# ── Job-alert filters — every one is optional; the value in () disables it ──
# A project is alerted only if it passes ALL enabled filters.
BOT_MIN_SCORE=0                  # alert only if score >= this (0 = alert on all)
BOT_MIN_BUDGET_USD=0             # min budget (0 = any budget)
BOT_SKIP_CURRENCIES=             # comma-separated codes to skip (empty = none; e.g. INR)
BOT_EXCLUDE_TITLE_KEYWORDS=      # skip if TITLE contains any of these (case-insensitive; e.g. wordpress,casino)
BOT_EXCLUDE_DESC_KEYWORDS=       # skip if DESCRIPTION contains any of these (case-insensitive)
BOT_EXCLUDE_SKILLS=              # skip if project is tagged with any of these skill badges (e.g. wordpress,php)
BOT_MAX_PROJECT_AGE_SECONDS=0    # only keep projects newer than N seconds (0 = any age)
BOT_MIN_BID_REMAINING_SECONDS=0  # skip if bidding closes in < N sec (0 = off; 6d22h = 597600)
BOT_MIN_CLIENT_COMPLETED_JOBS=0  # min client completed jobs (0 = disabled; needs owner_id)
BOT_REQUIRE_PAYMENT_VERIFIED=0   # 1 = only payment-verified clients (needs owner_id)
BOT_ALLOW_COUNTRIES=             # only these client countries (empty = any)
BOT_SKIP_COUNTRIES=              # block these client countries (empty = none)
#
# NOTE: client filters (completed-jobs / payment / country) only work in the
# WEBHOOK path, which has the client owner_id. The POLLING search has no
# owner_id, so keep those disabled (0/empty) for run-loop or nothing matches.
#
# To make it stricter later, e.g.: BOT_MIN_SCORE=70, BOT_MIN_BUDGET_USD=200,
# BOT_SKIP_CURRENCIES=INR, BOT_MAX_PROJECT_AGE_SECONDS=3600.

# Search criteria (comma-separated). These decide WHICH jobs are fetched.
BOT_KEYWORDS=react,nextjs,flutter,fastapi,api,bugfix
BOT_SKILLS=javascript,react.js,next.js,python,fastapi,flutter,node.js

BOT_WEBHOOK_SAVE_ONLY=1

# Bid defaults
BOT_DEFAULT_PERIOD_DAYS=7
BOT_DEFAULT_MILESTONE_PERCENT=50
# 1 = while polling, generate a proposal per matching project and save it to the
# bids table (status 'proposal_saved') for review. No bid is placed. Good for testing.
BOT_SAVE_PROPOSALS=0

# OpenAI (for AI proposals)
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-5.2-mini

# ── Proposal personalization (all optional; blank = built-in defaults) ──
BOT_SIGNATURE_NAME=              # name signed at the end of proposals
BOT_PORTFOLIO_URLS=             # comma-separated portfolio links the AI may cite
BOT_PROFILE_BULLETS=            # proof bullets about you, one per line (quote+\n if multi-line)
BOT_PROPOSAL_TEMPLATE=          # sample proposal the AI imitates for tone (quote if multi-line)
BOT_INCLUDE_NAME=1              # 1 = sign with your name on the last line
BOT_INCLUDE_PROFILE=1           # 1 = include proof bullets + portfolio
BOT_ASK_QUESTION=1              # 1 = open and close with a short question
BOT_PROPOSAL_PREFIX=            # literal text prepended to every proposal (e.g. "Hello,")
BOT_PROPOSAL_SUFFIX=            # literal text appended to every proposal (e.g. "Thanks!")

# ── AI project filtering (optional) — LLM accept/reject per job ──
BOT_AI_FILTER_ENABLED=0         # 1 = screen each candidate job with the AI (extra OpenAI call/job)
BOT_AI_FILTER_CRITERIA=         # plain-English rules (quote if multi-line)

# ── AI auto-pricing & duration (optional) — LLM sets bid amount + days ──
BOT_AI_PRICING_ENABLED=0        # 1 = AI sets amount/days; takes precedence over BOT_BID_RULES
BOT_AI_PRICING_RULES=           # plain-English pricing, e.g. "Logo = $50, 2 days" (quote if multi-line)

# Telegram notifications (leave blank to disable).
# 1) Create a bot via @BotFather -> get the token.
# 2) Message your bot, then get your chat id from @userinfobot
#    or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
# One chat id, or several comma-separated to notify multiple chats: 12345,67890
TELEGRAM_CHAT_ID=
# Extra bots, each with its OWN token + chat id (managed via the settings web UI).
# Alerts go to the primary bot above AND every bot listed here. JSON array:
# [{"token":"123:ABC","chat_id":"111"},{"token":"456:DEF","chat_id":"222"}]
TELEGRAM_BOTS=
